# Existing Google tag from the current TrainLyfe website.
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-KT9J4LQ

# Optional Google Tag Manager container ID. When set, GTM replaces the direct
# Google tag so GA4 and other destinations can be managed in one container.
NEXT_PUBLIC_GTM_ID=
# Build-time canonical origin. Keep daneff.com before the approved cutover;
# change to https://trainlyfe.com for the migration build.
NEXT_PUBLIC_SITE_URL=https://www.daneff.com

# Optional, inactive custom CRM intake uses these server-only settings.
# Public homepage/popup use GymnTX; these are NOT required for that form path.
# Leave unset unless the custom intake is separately approved and configured.
WEBSITE_INTAKE_URL=
WEBSITE_INTAKE_SECRET=
